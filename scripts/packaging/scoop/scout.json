{
    "version": "0.9.14",
    "description": "Local search for humans — local-first semantic file search (find files by meaning, across languages)",
    "homepage": "https://github.com/huibinma/Scout",
    "license": "MIT",
    "notes": [
        "Scout 经 NSIS 安装器装到 %LOCALAPPDATA%\\Scout（应用自身管理升级与卸载，非 Scoop 便携目录）。",
        "scoop uninstall 会运行应用卸载器：索引/模型/日志等本地数据将被清除（settings.json 保留）。",
        "安装包未签名（开源免费分发），SmartScreen 提示属正常：https://github.com/huibinma/Scout/blob/main/docs/install.md"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/huibinma/Scout/releases/download/v0.9.14/Scout_0.9.14_x64-setup.exe",
            "hash": "4e525b564e6243ecfa4daa7f6a765de68657c1afa821043fdc5f2045f3daf0bc"
        }
    },
    "installer": {
        "script": [
            "$setup = Get-ChildItem $dir -Filter '*-setup.exe' | Select-Object -First 1",
            "Start-Process -FilePath $setup.FullName -ArgumentList '/S' -Wait"
        ]
    },
    "uninstaller": {
        "script": [
            "$un = Join-Path $env:LOCALAPPDATA 'Scout\\uninstall.exe'",
            "if (Test-Path $un) { Start-Process -FilePath $un -ArgumentList '/S' -Wait }"
        ]
    },
    "checkver": {
        "github": "https://github.com/huibinma/Scout"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/huibinma/Scout/releases/download/v$version/Scout_$version_x64-setup.exe"
            }
        }
    }
}
